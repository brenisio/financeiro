    "test:all": "npm test && npm run test:ui",
    "serve": "python3 -m http.server 8797 --bind 127.0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.64.1"
  }
}
